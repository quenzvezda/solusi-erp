server:
  port: 8080
  # PENTING: Gunakan 'framework' agar Spring Boot mengenali header X-Forwarded-Proto (HTTPS) 
  # dari Reverse Proxy seperti Cloudflare Tunnel atau Nginx.
  forward-headers-strategy: framework
  servlet:
    session:
      timeout: 30m # Standard for ERP session timeout
      cookie:
        http-only: true
        # Set ke true jika menggunakan HTTPS agar cookie hanya dikirim melalui koneksi aman.
        secure: true

spring:
  # Konfigurasi DevTools untuk meningkatkan Developer Experience (DX)
  devtools:
    restart:
      # Hindari restart server jika hanya file statis atau template yang berubah
      exclude: static/**,public/**,templates/**,**/templates/**
      enabled: true
    livereload:
      # Aktifkan jika menggunakan ekstensi LiveReload di browser
      enabled: true
  application:
    name: solusi-program-erp

  # Database Configuration
  datasource:
    url: jdbc:mariadb://localhost:3306/solusi_erp_db
    username: root
    password:
    driver-class-name: org.mariadb.jdbc.Driver

  # JPA / Hibernate Configuration
  jpa:
    open-in-view: false # Recommended for ERP to avoid N+1 in views
    show-sql: true
    database-platform: org.hibernate.dialect.MariaDBDialect
    hibernate:
      ddl-auto: none # Strictly enforced: Use Flyway for DB changes
    properties:
      hibernate.format_sql: true

  # Flyway Migration Configuration
  flyway:
    enabled: true
    baseline-on-migrate: true
    locations: classpath:db/migration

  # Thymeleaf Configuration
  thymeleaf:
    cache: false # Disable for development
    mode: HTML

logging:
  level:
    org.springframework.security: DEBUG
    org.hibernate.SQL: DEBUG
    org.hibernate.type.descriptor.sql.BasicBinder: TRACE
