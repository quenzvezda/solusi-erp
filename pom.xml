<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.3</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.solusi</groupId>
    <artifactId>solusi-program-erp</artifactId>
    <version>1.6.2</version>
    <name>solusi-program-erp</name>
    <description>Enterprise Resource Planning System for Learning</description>

    <properties>
        <java.version>21</java.version>
        <org.mapstruct.version>1.6.3</org.mapstruct.version>
        <jacoco.version>0.8.14</jacoco.version>
        <poi.version>5.3.0</poi.version>
        <jasperreports.version>6.21.0</jasperreports.version>
    </properties>

    <dependencies>
        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Frontend Utilities -->
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
            <version>3.1.3.RELEASE</version>
        </dependency>

        <!-- HTML sanitization for rich text content (XSS protection) -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.18.3</version>
        </dependency>
        <!-- OGNL is required by Thymeleaf for expression evaluation in some environments -->
        <dependency>
            <groupId>ognl</groupId>
            <artifactId>ognl</artifactId>
            <version>3.2.21</version>
            <scope>test</scope>
        </dependency>

        <!-- Mapping & Boilerplate -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${org.mapstruct.version}</version>
        </dependency>

        <!-- Reporting (POI & JasperReports) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <dependency>
            <groupId>net.sf.jasperreports</groupId>
            <artifactId>jasperreports</artifactId>
            <version>${jasperreports.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>com.lowagie</groupId>
                    <artifactId>itext</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>1.3.32</version>
        </dependency>

        <!-- MinIO S3-compatible Storage Client -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.5.10</version>
        </dependency>

        <!-- DevTools -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Test Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.10.1</version>
                <configuration>
                    <release>${java.version}</release>
                    <!-- Force Maven and IDE to recognize the generated sources location -->
                    <generatedSourcesDirectory>${project.build.directory}/generated-sources/annotations</generatedSourcesDirectory>
                    <fork>true</fork>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <!-- Lombok-MapStruct binding is required -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${org.mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <compilerArg>-Amapstruct.defaultComponentModel=spring</compilerArg>
                        <compilerArg>-Amapstruct.verbose=true</compilerArg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-maven-plugin</artifactId>
                <version>11.14.1</version>
                <configuration>
                    <url>${env.DB_URL}</url>
                    <user>${env.DB_USERNAME}</user>
                    <password>${env.DB_PASSWORD}</password>
                    <cleanDisabled>false</cleanDisabled>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- Attach generated sources back to the module space so Vscode/Antigravity picks them up immediately -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>add-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/annotations</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- JaCoCo Code Coverage -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <!-- Spring Boot entry point -->
                                <exclude>com/solusi/erp/**/*Application*</exclude>
                                <!-- Spring config / DI wiring -->
                                <exclude>com/solusi/erp/**/config/**</exclude>
                                <exclude>com/solusi/erp/**/*Config*</exclude>
                                <!-- JPA entities and Spring Data repos -->
                                <exclude>com/solusi/erp/**/infrastructure/persistence/**</exclude>
                                <!-- Pure infrastructure adapters (JPA wrappers, no business logic) -->
                                <exclude>com/solusi/erp/**/infrastructure/adapter/**/*RepositoryImpl*</exclude>
                                <exclude>com/solusi/erp/**/infrastructure/adapter/**/*RepositoryAdapter*</exclude>
                                <!-- Web / security infrastructure -->
                                <exclude>com/solusi/erp/security/**/*Filter*</exclude>
                                <exclude>com/solusi/erp/security/**/*Interceptor*</exclude>
                                <exclude>com/solusi/erp/security/**/*AuthenticationSuccessHandler*</exclude>
                                <exclude>com/solusi/erp/security/**/*UserServiceImpl*</exclude>
                                <exclude>com/solusi/erp/**/web/*ExceptionHandler*</exclude>
                                <!-- DTOs / request-response objects (no business logic) -->
                                <exclude>com/solusi/erp/**/*Request*</exclude>
                                <exclude>com/solusi/erp/**/*Response*</exclude>
                                <exclude>com/solusi/erp/**/dto/**</exclude>
                                <exclude>com/solusi/erp/**/*Dto*</exclude>
                                <!-- MapStruct mappers (generated code) -->
                                <exclude>com/solusi/erp/**/*Mapper*</exclude>
                                <!-- Core value objects / enums with no testable logic -->
                                <exclude>com/solusi/erp/**/model/AuditMetadata*</exclude>
                                <exclude>com/solusi/erp/**/model/Page*</exclude>
                                <exclude>com/solusi/erp/**/model/DeleteResult*</exclude>
                                <exclude>com/solusi/erp/**/model/Pageable*</exclude>
                                <!-- Framework infrastructure -->
                                <exclude>com/solusi/erp/core/auditing/**</exclude>
                                <exclude>com/solusi/erp/core/event/**</exclude>
                                <exclude>com/solusi/erp/core/exception/DomainException*</exclude>
                                <!-- Web layer (controllers, templates — tested via integration) -->
                                <exclude>com/solusi/erp/**/web/controller/**</exclude>
                                <exclude>com/solusi/erp/**/web/template/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <haltOnFailure>false</haltOnFailure>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                            <excludes>
                                <!-- Application entry points & configuration -->
                                <exclude>com/solusi/erp/**/*Application*</exclude>
                                <exclude>com/solusi/erp/**/config/**</exclude>
                                <exclude>com/solusi/erp/**/*Config*</exclude>

                                <!-- Infrastructure layer (JPA, adapters, persistence) -->
                                <exclude>com/solusi/erp/**/infrastructure/**</exclude>

                                <!-- Web layer (controllers, DTOs, mappers, templates, validators) -->
                                <exclude>com/solusi/erp/**/web/**</exclude>

                                <!-- Security layer (filters, interceptors, auth) -->
                                <exclude>com/solusi/erp/security/**</exclude>

                                <!-- DTOs & mappers (may exist outside web/) -->
                                <exclude>com/solusi/erp/**/*Request*</exclude>
                                <exclude>com/solusi/erp/**/*Response*</exclude>
                                <exclude>com/solusi/erp/**/dto/**</exclude>
                                <exclude>com/solusi/erp/**/*Dto*</exclude>
                                <exclude>com/solusi/erp/**/*Mapper*</exclude>

                                <!-- Core framework classes (not business logic) -->
                                <exclude>com/solusi/erp/**/model/AuditMetadata*</exclude>
                                <exclude>com/solusi/erp/**/model/Page*</exclude>
                                <exclude>com/solusi/erp/**/model/DeleteResult*</exclude>
                                <exclude>com/solusi/erp/**/model/Pageable*</exclude>
                                <exclude>com/solusi/erp/core/auditing/**</exclude>
                                <exclude>com/solusi/erp/core/event/**</exclude>
                                <exclude>com/solusi/erp/core/exception/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>e2e</id>
            <dependencies>
                <dependency>
                    <groupId>com.h2database</groupId>
                    <artifactId>h2</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
