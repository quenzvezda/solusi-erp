# Database Configuration
DB_PORT=3306
DB_NAME=erp-test
DB_URL=jdbc:mariadb://localhost:${DB_PORT}/${DB_NAME}
DB_USERNAME=root
DB_PASSWORD=root

# Server Configuration
SERVER_PORT=8080

# MinIO Configuration (for Docker Compose development)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# MinIO Application Configuration (Spring Boot)
MINIO_ENDPOINT=http://localhost:9000
MINIO_USERNAME=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_BUCKET_SIGNATURES=approval-signatures
# MINIO_BUCKET_PRODUCTS=product-pictures  <- contoh untuk fitur baru nanti

# Security (Optional for future)
# APP_SECRET=your_secret_key_here

# JRebel Standalone Configuration (Optional for Hot Reload)
# Sesuaikan path ke file jrebel64.dll (Windows), libjrebel64.dylib (Mac), atau libjrebel64.so (Linux)
# JREBEL_AGENT_PATH=C:/jrebel/lib/jrebel64.dll
