# Database Configuration
DB_PORT=3306
DB_NAME=erp-test
DB_URL=jdbc:mariadb://localhost:${DB_PORT}/${DB_NAME}
DB_USERNAME=root
DB_PASSWORD=root

# Server Configuration
SERVER_PORT=8080
SERVER_COOKIE_SECURE=false

# Kafka Messaging Configuration
# Docker Compose host ports. Change these if the ports are already used locally.
KAFKA_PORT=9092
KAFKA_UI_PORT=8085
# Keep false so new topics must be added explicitly via scripts/infra.
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
# Spring Boot producer bootstrap server for host-run ERP.
KAFKA_BOOTSTRAP_SERVERS=localhost:${KAFKA_PORT}
# Keep disabled by default so ERP can run without Kafka/NotificationService.
ERP_MESSAGING_ENABLED=false
# Default generic approval event topic used by ERP outbox publisher.
ERP_MESSAGING_KAFKA_DEFAULT_TOPIC=erp.approval.events.v1

# MinIO Configuration
# Docker Compose host ports. Change these if the ports are already used locally.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# INTERNAL: SDK endpoint (direct to MinIO, no proxy)
MINIO_ENDPOINT=http://localhost:9000
# EXTERNAL: Presigned URLs endpoint (via HTTPS proxy, or localhost in dev)
MINIO_PRESIGNED_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_SIGNATURES=approval-signatures
# MINIO_BUCKET_PRODUCTS=product-pictures  <- example for future features

# Security (Optional for future)
# APP_SECRET=your_secret_key_here

# JRebel Standalone Configuration (Optional for Hot Reload)
# Sesuaikan path ke file jrebel64.dll (Windows), libjrebel64.dylib (Mac), atau libjrebel64.so (Linux)
# JREBEL_AGENT_PATH=C:/jrebel/lib/jrebel64.dll
